    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.ai-personal-assistant-suite-iqrof76t-9bs2scax-m9xkyh13-kc78crp0",
      "infoPlist": {
